{
    "manifest_version": 3,
    "name": "GitHub书签同步",
    "version": "1.0",
    "description": "将浏览器书签同步到GitHub仓库",
    "permissions": [
        "bookmarks",
        "storage",
        "unlimitedStorage"
    ],
    "host_permissions": [
        "*://*.workers.dev/*",
        "https://api.github.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": false
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
